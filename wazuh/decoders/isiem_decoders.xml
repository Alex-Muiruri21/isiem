<!--
  ISIEM custom decoders  ->  /var/ossec/etc/decoders/isiem_decoders.xml  (WAZUH MANAGER)

  Decodes the kernel log line written by the iptables LOG rule from
  attacks/endpoint_prep.sh, e.g.
    Oct 22 12:06:20 endpoint-1 kernel: [ 1234.567890] ISIEM-SYN: IN=ens33 OUT=
    MAC=... SRC=192.168.242.204 DST=192.168.242.200 LEN=60 TOS=0x00 PREC=0x00
    TTL=64 ID=54321 DF PROTO=TCP SPT=41234 DPT=22 WINDOW=64240 RES=0x00 SYN URGP=0
  into srcip / dstip / protocol / srcport / dstport, which rule 100020 turns into
  an alert the ML engine can count.

  The two decoders share a name on purpose: Wazuh "sibling" decoders apply in
  sequence, the second continuing after the first one's match.

  ALWAYS test before restarting the manager:
    sudo /var/ossec/bin/wazuh-analysisd -t         # config/ruleset syntax check
    sudo /var/ossec/bin/wazuh-logtest              # paste one real kern.log line
  logtest must report decoder 'isiem-syn' with srcip, dstip, dstport and rule 100020.
-->
<decoder name="isiem-syn">
  <prematch>ISIEM-SYN: </prematch>
</decoder>

<decoder name="isiem-syn-fields">
  <parent>isiem-syn</parent>
  <regex>SRC=(\S+) DST=(\S+) </regex>
  <order>srcip,dstip</order>
</decoder>

<decoder name="isiem-syn-fields">
  <parent>isiem-syn</parent>
  <regex offset="after_regex">PROTO=(\S+) SPT=(\d+) DPT=(\d+) </regex>
  <order>protocol,srcport,dstport</order>
</decoder>
